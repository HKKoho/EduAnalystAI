# Edu-Analyst AI Backend Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE (Required)
# =============================================================================

# PostgreSQL connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Railway provides this automatically when you add a PostgreSQL plugin
DATABASE_URL=postgresql://postgres:password@localhost:5432/edu_analyst

# =============================================================================
# API KEYS (Required)
# =============================================================================

# Google Gemini API Key
# Get yours at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# LLM CONFIGURATION
# =============================================================================

# Model name (default: gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
GEMINI_MODEL=gemini-1.5-flash

# Generation parameters
TEMPERATURE=0.3
TOP_P=0.9
MAX_OUTPUT_TOKENS=8192

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application name
APP_NAME=Edu-Analyst AI

# Port to run server on
PORT=8000

# Environment: development or production
NODE_ENV=development

# CORS origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# RATE LIMITING
# =============================================================================

# Maximum requests per window
RATE_LIMIT_REQUESTS=10

# Window size in seconds
RATE_LIMIT_WINDOW=60

# =============================================================================
# CACHING
# =============================================================================

# Enable/disable caching
CACHE_ENABLED=true

# Cache TTL in seconds (1 hour default)
CACHE_TTL=3600
